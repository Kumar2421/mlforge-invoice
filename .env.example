# ── Supabase ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Public site URL (SEO, OAuth redirects, email links) ──────────────────
# Set to the production domain. Netlify also injects URL automatically.
NEXT_PUBLIC_SITE_URL=https://invoice.mlforge.com

# ── Customer Stripe connection (read-only OAuth app) ─────────────────────
STRIPE_CLIENT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=              # for /api/v1/webhooks/stripe (connected account events)

# ── Our own subscription billing (Stripe Checkout for OUR plans) ─────────
STRIPE_PRICE_SOLO=price_xxx         # $9/mo recurring price id
STRIPE_PRICE_PRO=price_xxx          # $15/mo recurring price id
STRIPE_BILLING_WEBHOOK_SECRET=      # for /api/v1/webhooks/billing (checkout + subscription events)

# ── Email (Resend) ──────────────────────────────────────────────────────
RESEND_API_KEY=
PLATFORM_POSTAL_ADDRESS="mlforge Invoice, <your real business mailing address>"

# ── PayPal (customer read-only connection) ────────────────────────────────
# OAuth app credentials for PayPal invoicing API (Phase 5.5 feature)
# Get from developer.paypal.com → App Connections
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox                 # sandbox or production

# ── Cron ────────────────────────────────────────────────────────────────
CRON_SECRET=                        # Bearer token the scheduled reminder sweep must present
