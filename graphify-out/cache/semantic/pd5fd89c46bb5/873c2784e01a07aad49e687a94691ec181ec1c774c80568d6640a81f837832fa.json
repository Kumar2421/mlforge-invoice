{"nodes": [{"id": "claude_skills_directory_submissions_skill", "label": "Directory Submissions Skill", "file_type": "document", "source_file": ".claude/skills/directory-submissions/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "directory_submissions_foundation_before_submission", "label": "Foundation Before Submission Rule", "file_type": "rationale", "source_file": ".claude/skills/directory-submissions/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never submit to a directory until the destination landing page is live, indexed, and meets SEO/GEO readiness criteria (single H1, pricing page, privacy/terms, logo assets, screenshots, demo video, FAQ schema, structured data) \u2014 because clean-hierarchy pages get 2.8x higher AI citation rates and directories are worthless without a converting destination."}, {"id": "directory_submissions_destination_before_directories", "label": "Destination Pages Before Directories Rule", "file_type": "rationale", "source_file": ".claude/skills/directory-submissions/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Directories are link-equity sources; alternative/use-case/template pages are the destinations that convert that traffic (5-15% vs 0.5-2% for generic content) \u2014 build destinations first so the link equity has somewhere useful to land."}, {"id": "directory_submissions_positioning_varies_rule", "label": "Positioning Varies by Directory Type Rule", "file_type": "rationale", "source_file": ".claude/skills/directory-submissions/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never reuse the same description across directories \u2014 AI engines penalize duplicate content and each directory audience (startup founders, SaaS alternative-seekers, AI-first buyers, devs, no-coders, B2B reviewers) responds to different framing."}, {"id": "directory_submissions_product_hunt_algorithm", "label": "Product Hunt 2026 Comment-Quality Algorithm", "file_type": "rationale", "source_file": ".claude/skills/directory-submissions/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "2026 PH algorithm weights comment quality over upvote count; 80% of failed launches fail from launching without a warm audience or asking for upvotes instead of feedback, so the skill instructs asking for feedback and never for upvotes."}, {"id": "directory_submissions_g2_10in30_protocol", "label": "G2/Capterra 10-in-30 Review Protocol", "file_type": "rationale", "source_file": ".claude/skills/directory-submissions/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Listings are worthless without reviews (10 is the Grid-appearance threshold); protocol asks 20 users directly via email with a modest incentive to reach ~50% conversion, because G2/Capterra explicitly allow small incentives and direct links reduce friction ~70%."}], "edges": [{"source": "claude_skills_directory_submissions_skill", "target": "claude_skills_directory_list_ref", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/skills/directory-submissions/SKILL.md", "source_location": null, "weight": 1}, {"source": "claude_skills_directory_submissions_skill", "target": "claude_skills_positioning_variations_ref", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/skills/directory-submissions/SKILL.md", "source_location": null, "weight": 1}, {"source": "claude_skills_directory_submissions_skill", "target": "directory_submissions_foundation_before_submission", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/skills/directory-submissions/SKILL.md", "source_location": null, "weight": 1}, {"source": "claude_skills_directory_submissions_skill", "target": "directory_submissions_destination_before_directories", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/skills/directory-submissions/SKILL.md", "source_location": null, "weight": 1}, {"source": "claude_skills_directory_submissions_skill", "target": "directory_submissions_positioning_varies_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/skills/directory-submissions/SKILL.md", "source_location": null, "weight": 1}, {"source": "directory_submissions_positioning_varies_rule", "target": "claude_skills_positioning_variations_ref", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/skills/directory-submissions/SKILL.md", "source_location": null, "weight": 1}, {"source": "claude_skills_directory_submissions_skill", "target": "directory_submissions_product_hunt_algorithm", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/skills/directory-submissions/SKILL.md", "source_location": null, "weight": 1}, {"source": "directory_submissions_product_hunt_algorithm", "target": "product_hunt", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/skills/directory-submissions/SKILL.md", "source_location": null, "weight": 1}, {"source": "claude_skills_directory_submissions_skill", "target": "directory_submissions_g2_10in30_protocol", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/skills/directory-submissions/SKILL.md", "source_location": null, "weight": 1}, {"source": "directory_submissions_g2_10in30_protocol", "target": "g2", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1