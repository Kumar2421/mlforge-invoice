{"nodes": [{"id": "clone_website_skill", "label": "clone-website Skill", "file_type": "document", "source_file": ".github/skills/clone-website/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "clone_website_foreman_builder_pattern", "label": "Foreman/Builder Extraction Pattern", "file_type": "rationale", "source_file": ".github/skills/clone-website/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not a two-phase inspect-then-build process \u2014 the orchestrator acts as a foreman walking the job site, writing a detailed spec file per section then handing it to a specialist builder agent so extraction and construction happen in parallel while extraction stays meticulous and auditable."}, {"id": "clone_website_small_tasks_principle", "label": "Small Tasks, Perfect Results Principle", "file_type": "rationale", "source_file": ".github/skills/clone-website/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An agent given an entire complex section approximates and guesses; an agent given one focused component with exact CSS values nails it \u2014 complexity budget rule: if a builder prompt exceeds ~150 lines of spec, split the section further."}, {"id": "clone_website_interaction_model_principle", "label": "Identify Interaction Model Before Building Principle", "file_type": "rationale", "source_file": ".github/skills/clone-website/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Building a click-based UI when the original is scroll-driven (or vice versa) is the single most expensive cloning mistake, forcing a full rewrite instead of a CSS fix \u2014 determine by scrolling first without clicking, then testing hover/click only if nothing changed on scroll."}, {"id": "clone_website_foundation_first_principle", "label": "Foundation First Principle", "file_type": "rationale", "source_file": ".github/skills/clone-website/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Global CSS design tokens, TypeScript content types, and global assets must exist before any component build starts \u2014 this step is sequential and non-negotiable, everything after can be parallel."}, {"id": "clone_website_spec_file_source_of_truth", "label": "Spec Files Are the Source of Truth Principle", "file_type": "rationale", "source_file": ".github/skills/clone-website/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every component must get a written spec file before a builder is dispatched, both as the contract for the builder's prompt and as a persistent auditable artifact for later review; skipping it means the builder guesses to fill gaps."}, {"id": "atlas_cloud_fallback_concept", "label": "Atlas Cloud Fallback for Unrecoverable Assets", "file_type": "concept", "source_file": ".github/skills/clone-website/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "behaviors_md_artifact", "label": "BEHAVIORS.md Artifact Pattern", "file_type": "concept", "source_file": ".github/skills/clone-website/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "page_topology_md_artifact", "label": "PAGE_TOPOLOGY.md Artifact Pattern", "file_type": "concept", "source_file": ".github/skills/clone-website/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "clone_website_skill", "target": "clone_website_foreman_builder_pattern", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "s